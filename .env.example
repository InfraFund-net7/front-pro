# =============================================================================
# InfraFund Next.js local/runtime environment
# Generated from .env.local with secret-safe example values.
# Run: npm run env:example
# =============================================================================

# =============================================================================
# Application Configuration
# =============================================================================
# Set service environment: development, preview, or production
NEXT_PUBLIC_ENVIRONMENT=development

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================
# Local default matches deployment/docker-compose.local.yml
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infra_dev?sslmode=disable

# =============================================================================
# Privy Configuration (auth + embedded wallet)
# =============================================================================
# Client-side app ID from https://dashboard.privy.io — also read server-side
# for token verification, see server/env.ts
NEXT_PUBLIC_PRIVY_APP_ID=<privy-app-id>
# Server-side app secret from Privy Dashboard > API Keys
PRIVY_APP_SECRET=<privy-app-secret>

# =============================================================================
# Biconomy Configuration (smart-account layer on top of the Privy EOA)
# =============================================================================
# Not yet read by any code path — smart-account address derivation is
# counterfactual (no API call needed). Reserved for the transaction-sending
# phase (gas sponsorship / MEE), see docs/superpowers/specs/2026-08-03-biconomy-wallet-infra-design.md
# NEXT_PUBLIC_BICONOMY_API_KEY=
# NEXT_PUBLIC_BICONOMY_PROJECT_ID=

# =============================================================================
# App Session Auth Configuration
# =============================================================================
# Generate with: openssl rand -base64 32
APP_JWT_SECRET=<base64-32-byte-secret>
APP_JWT_ISSUER=
APP_JWT_AUDIENCE=infrafund
APP_JWT_ACCESS_TOKEN_TTL=15m
APP_AUTH_SESSION_ACTIVITY_TIMEOUT=15m
APP_AUTH_SESSION_ABSOLUTE_TTL=7d
APP_REFRESH_COOKIE_DOMAIN=
APP_REFRESH_COOKIE_SAME_SITE=lax

# =============================================================================
# reCAPTCHA Configuration
# =============================================================================
# Required for public form endpoints
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=<recaptcha-site-key>
RECAPTCHA_SECRET_KEY=<recaptcha-secret-key>

# =============================================================================
# Cesium Ion Configuration
# =============================================================================
# Client-side Cesium Ion token for 3D Tiles digital twin assets
NEXT_PUBLIC_CESIUM_ION_ACCESS_TOKEN=<cesium-ion-access-token>

# =============================================================================
# Digital Twin Demo Mode
# =============================================================================
# Off by default. When "true", the developer home "AI Digital Twin" links
# fall back to a fixed, always-seeded demo project (see
# scripts/seed-demo-digital-twin-project.mjs) instead of rendering as
# disabled when the current user has no real project yet.
NEXT_PUBLIC_DIGITAL_TWIN_DEMO_MODE=false

# =============================================================================
# Azure Storage Configuration
# =============================================================================
# Required for proposal document uploads
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=project-proposals

# =============================================================================
# Cleanup Cron Configuration
# =============================================================================
# Generate with: openssl rand -base64 32
CRON_SECRET=<base64-32-byte-secret>

# =============================================================================
# Sentry Error Reporting
# =============================================================================
# The SDK is fully wired (instrumentation-client.ts, sentry.server.config.ts,
# sentry.edge.config.ts) but stays inert until a DSN is set -- both are
# gated on `enabled: Boolean(dsn)`. Get a DSN from https://sentry.io once a
# project exists; both vars take the same DSN value (client vs server SDK).
NEXT_PUBLIC_SENTRY_DSN=<sentry-dsn>
SENTRY_DSN=<sentry-dsn>
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ENVIRONMENT=development

# =============================================================================
# Contact Form Email Configuration
# =============================================================================
# Optional; SMTP values are required only when CONTACT_FORM_EMAIL_ENABLED=true
CONTACT_FORM_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=<smtp-password>
SMTP_SENDER=
CONTACT_FORM_RECEIVER=
