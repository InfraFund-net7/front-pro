# Openfort (from https://dashboard.openfort.io)
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_OPENFORT_PUBLIC_KEY=pk_test_...
OPENFORT_SECRET_KEY=sk_test_...
OPENFORT_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_SHIELD_API_KEY=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/infrafund

# Gas sponsorship policy (optional)
NEXT_PUBLIC_POLICY_ID=

# WalletConnect project ID (optional, enables external wallets)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# reCAPTCHA (required for non-resident waitlist)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# App session auth
APP_JWT_SECRET=
APP_JWT_ISSUER=
APP_JWT_AUDIENCE=infrafund
APP_JWT_ACCESS_TOKEN_TTL=15m
APP_AUTH_SESSION_ACTIVITY_TIMEOUT=15m
APP_AUTH_SESSION_ABSOLUTE_TTL=7d
APP_REFRESH_COOKIE_DOMAIN=
APP_REFRESH_COOKIE_SAME_SITE=lax

# Server-side only (from: openfort embedded-wallet setup)
SHIELD_SECRET_KEY=
SHIELD_ENCRYPTION_SHARE=

# Cleanup cron
CRON_SECRET=

# Contact form email (optional)
CONTACT_FORM_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
CONTACT_FORM_RECEIVER=
