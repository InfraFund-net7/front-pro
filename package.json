{
  "name": "front-pro",
  "version": "0.2.6",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "prisma generate && node scripts/setup-neon-db.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "build-start": "npm run build && npm run start",
    "db:generate": "prisma generate",
    "db:local:setup": "node scripts/setup-local-db.mjs",
    "db:local:seed": "node scripts/seed-countries.mjs",
    "db:local:down": "docker compose -f deployment/docker-compose.local.yml down",
    "db:neon:setup": "node scripts/setup-neon-db.mjs",
    "dev:local": "npm run db:local:setup && npm run dev:log",
    "dev:log": "next dev -p 3000 2>&1 | tee .next/dev-server.log",
    "env:example": "node scripts/generate-env-example.mjs",
    "format": "npm run format:lint && npm run format:prettier && npm run format:cspell && npm run format:knip",
    "format:lint": "eslint",
    "format:prettier": "prettier . --check",
    "format:cspell": "cspell",
    "format:knip": "knip",
    "fix:prettier": "prettier --write .",
    "fix:lint": "eslint --fix .",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@openfort/openfort-js": "^1.3.3",
    "@openfort/openfort-node": "^0.10.3",
    "@openfort/react": "^1.0.15",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sentry/nextjs": "^10.50.0",
    "@tanstack/react-query": "^5.100.5",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "jotai": "^2.19.1",
    "lucide-react": "^1.11.0",
    "next": "^16.2.4",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "server-only": "^0.0.1",
    "viem": "^2.48.4",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "cspell": "^10.0.0",
    "eslint": "^10.2.1",
    "eslint-config-next": "^16.2.4",
    "husky": "^9.1.7",
    "knip": "^6.7.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3"
  }
}
