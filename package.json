{
  "name": "Infrafund/front-pro",
  "version": "1.3.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start -p 3000",
    "build-start": "npm run build && npm run start",
    "pretypecheck": "prisma generate && next typegen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:local:setup": "node scripts/setup-local-db.mjs",
    "db:local:seed": "node scripts/seed-countries.mjs",
    "db:local:down": "docker compose -f deployment/docker-compose.local.yml down",
    "db:remote:bootstrap": "node scripts/ensure-uuidv7.mjs",
    "db:remote:migrate": "prisma migrate deploy",
    "db:remote:setup": "node scripts/setup-remote-db.mjs",
    "db:backfill:digital-twin-status": "node scripts/backfill-digital-twin-status.mjs",
    "db:seed:demo-digital-twin": "node scripts/seed-demo-digital-twin-project.mjs",
    "dev:local": "npm run db:local:setup && npm run dev:log",
    "dev:log": "next dev -p 3000 2>&1 | tee .next/dev-server.log",
    "env:example": "node scripts/generate-env-example.mjs",
    "check:prisma-migrations": "node scripts/check-prisma-migration-sync.mjs",
    "format": "npm run format:lint && npm run format:prettier && npm run format:cspell && npm run format:knip",
    "format:lint": "eslint",
    "format:prettier": "prettier . --check",
    "format:cspell": "cspell lint --quiet",
    "format:knip": "knip",
    "fix:prettier": "prettier --write .",
    "fix:lint": "eslint --fix .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write",
      "cspell lint --quiet --no-must-find-files"
    ],
    "*.md": [
      "prettier --write",
      "cspell lint --quiet --no-must-find-files"
    ],
    "*.{json,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@biconomy/abstractjs": "^1.2.5",
    "@metamask/delegation-toolkit": "^0.11.0",
    "@noble/curves": "2.0.1",
    "@openzeppelin/merkle-tree": "1.0.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@privy-io/node": "^0.27.0",
    "@privy-io/react-auth": "^3.35.2",
    "@privy-io/server-auth": "^1.32.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@rhinestone/module-sdk": "0.4.0",
    "@safe-global/types-kit": "3.0.0",
    "@sentry/nextjs": "^10.50.0",
    "@tanstack/react-query": "^5.100.5",
    "@types/three": "^0.184.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.11.0",
    "next": "^16.2.6",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "server-only": "^0.0.1",
    "three": "^0.184.0",
    "viem": "^2.48.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitejs/plugin-react": "^6.0.5",
    "cspell": "^10.0.0",
    "eslint": "^10.2.1",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "knip": "^6.7.0",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
