{
  "name": "front-pro",
  "version": "0.2.6",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "build-start": "npm run build && npm run start",
    "db:generate": "prisma generate",
    "format": "npm run format:lint && npm run format:prettier && npm run format:cspell && npm run format:knip",
    "format:lint": "eslint",
    "format:prettier": "prettier . --check",
    "format:cspell": "cspell",
    "format:knip": "knip",
    "fix:prettier": "prettier --write .",
    "fix:lint": "eslint --fix .",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@openfort/openfort-js": "^1.3.3",
    "@openfort/react": "^1.0.12",
    "@prisma/client": "^6.19.3",
    "@sentry/nextjs": "^10.49.0",
    "@tanstack/react-query": "^5.99.0",
    "clsx": "^2.1.1",
    "jotai": "^2.19.1",
    "lucide-react": "^0.526.0",
    "next": "^15.5.15",
    "pino": "^10.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "viem": "^2.47.12",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "cspell": "^9.8.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.15",
    "husky": "^9.1.7",
    "knip": "^5.66.2",
    "postcss": "^8.5.9",
    "prettier": "^3.8.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
