{
  "name": "front-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "build-start": "npm run build && npm run start",
    "format": "npm run format:lint && npm run format:prettier && npm run format:cspell && npm run format:knip",
    "format:lint": "eslint",
    "format:prettier": "prettier . --check",
    "format:cspell": "cspell",
    "format:knip": "knip",
    "fix:prettier": "prettier --write .",
    "fix:lint": "eslint --fix .",
    "prepare": "husky"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependencies": {
    "@next/font": "^14.2.15",
    "@openfort/react": "^1.0.15",
    "@solana/kit": "^5.5.1",
    "@tanstack/react-query": "^5.83.0",
    "axios": "^1.11.0",
    "ethers": "^6.16.0",
    "jotai": "^2.12.5",
    "lucide-react": "^0.526.0",
    "next": "15.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "^2.43.1",
    "wagmi": "^2.16.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/react-responsive": "^8.0.8",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "autoprefixer": "^10.4.22",
    "cspell": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.2",
    "husky": "^9.1.7",
    "knip": "^5.66.2",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
